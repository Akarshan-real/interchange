{
    "manifest_version": 3,
    "name": "Interchange",
    "short_name": "Interchange",
    "version": "1.0.0",
    "description": "Sync play/pause between two media tabs. Pause YouTube and Spotify plays. Resume it and Spotify pauses. Works with YouTube, YouTube Music and Spotify.",
    "author": "Akarshan",
    "homepage_url": "https://github.com/Akarshan-real/interchange",
    "minimum_chrome_version": "88",
    "icons": {
        "16": "icon/interchange.png",
        "48": "icon/interchange.png",
        "128": "icon/interchange.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon/interchange.png",
            "48": "icon/interchange.png",
            "128": "icon/interchange.png"
        },
        "default_title": "Interchange — Sync your media tabs"
    },
    "permissions": [
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "https://*.youtube.com/*",
        "https://*.spotify.com/*",
        "https://*.music.youtube.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.youtube.com/*",
                "https://*.spotify.com/*",
                "https://*.music.youtube.com/*"
            ],
            "js": [
                "contentScript.js"
            ],
            "run_at": "document_idle"
        }
    ]
}